<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">

  <!-- The name identifies the cloud and must round-trip, but it is not
       editable: Jenkins checks for duplicates only when a cloud is created, so
       editing it here could introduce one. Rename via "Display name" instead. -->
  <f:invisibleEntry>
    <f:textbox field="name"/>
  </f:invisibleEntry>

  <f:entry title="${%Display name}" field="displayName">
    <f:textbox/>
  </f:entry>

  <f:entry title="${%Namespace Proj ID}" field="registryPrefix"
           description="${%Your Namespace workspace or project id — abc012abc012 in nscr.io/abc012abc012/jenkins-agent:1.0. Needed so the agent-image list can build pullable references. Find it with: nsc registry list}">
    <f:textbox/>
  </f:entry>

  <f:entry title="${%Namespace token}" field="credentialsId">
    <c:select xmlns:c="/lib/credentials"/>
  </f:entry>

  <f:entry title="${%API endpoint}" field="region"
           description="${%Which regional ComputeService host to talk to. This is not the instance placement.}">
    <f:select/>
  </f:entry>

  <f:validateButton title="${%Test connection}" progress="${%Checking…}"
                    method="testConnection"
                    with="region,computeEndpointOverride,registryPrefix,credentialsId"/>

  <f:section title="${%Required permissions}">
    <f:entry>
      <div class="jenkins-form-description">
        <p>
          ${%The token is used only for the calls below. Grant nothing more — a token scoped
            to these actions cannot read your vault, registry or other workspace resources.}
        </p>
        <table class="jenkins-table jenkins-table--small">
          <thead>
            <tr>
              <th>${%Resource}</th>
              <th>${%Actions}</th>
              <th>${%Why}</th>
            </tr>
          </thead>
          <tbody>
            <j:forEach var="g" items="${descriptor.requiredGrants}">
              <tr>
                <td><code>${g.resourceType}</code></td>
                <td><code>${g.actionsCsv}</code></td>
                <td>${g.why}<j:if test="${g.optional}"> <em>(${%optional})</em></j:if></td>
              </tr>
            </j:forEach>
          </tbody>
        </table>
        <p>${%Mint a token with exactly these grants:}</p>
        <pre style="white-space:pre-wrap">${descriptor.nscTokenCommand}</pre>
        <p>
          ${%The ssh and ingress grants are only needed if a profile below uses the SSH launcher.}
          ${%Store the resulting token as a "Secret text" credential and select it above.}
        </p>
      </div>
    </f:entry>
  </f:section>

  <f:advanced>
    <f:entry title="${%Compute endpoint override}" field="computeEndpointOverride"
             description="${%Leave blank to derive it from the region above.}">
      <f:textbox/>
    </f:entry>
    <f:entry title="${%Instance region}" field="instanceRegion"
             description="${%Site to place instances in, e.g. ord. Leave blank — recommended — to let Namespace pick one with capacity.}">
      <f:textbox/>
    </f:entry>
    <f:entry title="${%Jenkins URL override}" field="jenkinsUrlOverride">
      <f:textbox/>
    </f:entry>
    <f:entry title="${%Instance cap}" field="instanceCap">
      <f:number default="50" min="1"/>
    </f:entry>
  </f:advanced>

  <f:entry title="${%Agent profiles}" description="${%Each profile maps a Jenkins label to an instance shape.}">
    <f:repeatableProperty field="templates" addCaption="${%Add a profile}"/>
  </f:entry>

</j:jelly>
